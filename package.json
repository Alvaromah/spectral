{
  "name": "@spectral-zx/toolkit",
  "version": "0.1.0",
  "description": "Spectral — AI agent toolchain for the ZX Spectrum: assemble, run headless, observe, debug, iterate.",
  "license": "MIT",
  "author": "Alvaro Mateos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alvaromah/spectral.git"
  },
  "homepage": "https://alvaromah.github.io/spectral/",
  "bugs": {
    "url": "https://github.com/Alvaromah/spectral/issues"
  },
  "keywords": [
    "zx-spectrum",
    "z80",
    "emulator",
    "sjasmplus",
    "assembly",
    "ai-agents",
    "mcp",
    "retro",
    "game-development"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "zxs": "dist/cli/index.js",
    "zxs-mcp": "dist/mcp/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/reference",
    "recipes",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "test": "tsup --silent && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^14.0.0",
    "pngjs": "^7.0.0",
    "zod": "^3.25.0",
    "zx-generation": "1.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pngjs": "^6.0.5",
    "prettier": "^3.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
